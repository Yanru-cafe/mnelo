# hermes-memory 配置示例
# 拷贝此文件为 config.toml (与 memory.db 在同目录) 并按需修改.
# 或用环境变量覆盖 (优先级高, 前缀 MNELO_MEMORY_):
#   MNELO_MEMORY_TIMEZONE=utc
#   MNELO_MEMORY_WARM_UP_EMBEDDER=false
#   MNELO_MEMORY_EMBEDDER_MODEL=BAAI/bge-small-en-v1.5
#   MNELO_MEMORY_EMBEDDER_DIM=384
#   MNELO_MEMORY_DIR=/path/to/memory   (live 目录, 默认 ~/.hermes/memory)
#   MNELO_MEMORY_DB_PATH=/path/to/memory.db  (完整 DB 路径, 覆盖 MNELO_MEMORY_DIR)

[main]
# 时区选项 (默认 'local', 即系统本地时区):
#   - 'local'    → 用系统时区 (: BJT +0800)
#   - 'utc'      → 用 UTC
#   - '<IANA>'   → 任意 IANA tz 名 (e.g. 'Asia/Shanghai', 'America/New_York')
timezone = 'local'

# Memory.__init__ 时是否立即 warm-up Embedder 模型
# True (推荐): 启动慢 1s, 避免首次 recall 冷启动 1s
# False: 启动快, 首次 recall 慢 1s (only do this in CI / 测试场景)
warm_up_embedder = true

[embedder]
# 切换 embedding 模型 — model + dim 必须严格匹配, 错配 sqlite-vec insert 会失败
#
# 选项:
#   中文 (默认):        'BAAI/bge-small-zh-v1.5',                                dim=512
#   英文:               'BAAI/bge-small-en-v1.5',                                dim=384
#   多语种 (50+):       'sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2', dim=384
#                       覆盖: 日本語 / 한국어 / Español / Français / Deutsch / 中文 / English …
#
# : 切语言前必须重新 `python3 scripts/init_db.py` — sqlite-vec 表 schema 绑死 dim
#       (历史 chunk 的 embedding 维度跟新 dim 不一致会冲突, 见 RUNBOOK § migration)
model = 'BAAI/bge-small-zh-v1.5'
dim = 512

[storage]
# 存储目录 (默认 ~/.hermes/memory, 与旧部署向后兼容).
# 一般无需设置 — 改环境变量 MNELO_MEMORY_DIR / MNELO_MEMORY_DB_PATH 更灵活.
# dir = '~/.hermes/memory'

[search]
# 检索索引后端 (8/6 plan §1 — 向量库必选二选一, sqlite_vec 已出局):
#   'auto'   (默认) — 自动链 zvec > usearch: 新 CPU 用 zvec (INT8 精度), 用不了 zvec 用 usearch (f16 精度)
#   'zvec'           — 阿里 zvec (进程内嵌, HNSW+原生FTS+INT8量化). 需 AVX2+, 旧 CPU import 即崩 → 启动 fail-fast
#   'usearch'        — HNSW, 任意 CPU, f16 精度 (8/6 plan 精度分层)
# 精度随后端定死: zvec=INT8, usearch=f16 (烘焙进索引类, 不做 config 项)
# 环境变量覆盖: MNELO_MEMORY_SEARCH_BACKEND
backend = 'auto'

[digest]
# 8/4 TASKS_L2_DIGEST.md — 常驻记忆摘要 + 可逆压缩 (DESIGN §4.5 + §4.5.2 v0.13)
# 纯派生视图 (deterministic), 无 LLM, 实战 main memory 0 mutation
# 需选 inject_on_initialize=true 实战 MCP initialize 附带摘要
# 环境变量覆盖: MNELO_MEMORY_DIGEST_*
enabled = true               # 默认开 (纯派生视图, 无副作用)
max_chars = 2000             # §4.5.1 体积护栏
recent_window_days = 30      # 块2 时间窗
importance_threshold = 0.8   # 块2 高 importance 门槛
inject_on_initialize = false # 默认显式调用 (避免每次连接拉摘要 token 开销)

[recall]
# [8/5 普适化] RRF 实体 boost 的 kind 清单 — 哪些 kind 的 entity 命中给 RRF boost。
# 默认 ['stock'] 兼容旧行为; 设你领域的 kind (如 ['product','category']) 或 [] 禁用。
# 环境变量覆盖: MNELO_MEMORY_RECALL_BOOST_KINDS='product,location'
# boost_kinds = ['stock']

# [8/9 增量] config.toml 新增 4 sections — commit 4b09bfb / 42d7954 提到 config.
# 这些 section 如缺, config 走 hardcoded default.

[rate_limit]
# [42d7954] mcp_server 限流配置. 主人 8/9 部署 60 req / 60s 单 tool sliding window.
# env MNELO_MEMORY_RATE_LIMIT_MAX_REQS 覆盖.
max_reqs = 60
window_seconds = 60

[validation]
# [4b09bfb] PII / namespace 校验配置. 主人 8/9 默认开 strict.
# env MNELO_MEMORY_VALIDATION_STRICT 覆盖 (true / false).
strict = true

[task]
# [4b09bfb] task_states stale 阈值. env MNELO_MEMORY_TASK_STALE_DAYS_THRESHOLD 覆盖.
# 非法 (非数字 / < 1) 回落 7 (跟 8/9 review B2 fix 一致).
stale_days_threshold = 7

[client]
# [4b09bfb] mnelo_remote_client.py 配置. env MNELO_MEMORY_CLIENT_TAILSCALE_HOST 覆盖.
tailscale_host = "mnelo.tail6a710.ts.net"
