<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
mnelo MCP server — launchd plist 模板.

本文件由 scripts/install.sh 渲染 (sed 替换占位符) 后安装到 ~/Library/LaunchAgents/ai.mnelo.mcp.plist.
占位符 (双下划线前缀):
  __LIVE_ROOT__  → $MNELO_HOME/memory (e.g. /Users/apple/.hermes/memory)
  __VENV_PY__    → venv/bin/python3 (e.g. /Users/apple/.hermes/memory/.venv/bin/python3)
  __BIND_HOST__  → 127.0.0.1 (loopback) 或 0.0.0.0 (multi-agent Tailscale) — install.sh 询问决定

[8/8 Tailscale multi-agent] bind host 选择 (主人 8/8 拍板):
  - 单机本地:   --host 127.0.0.1 (loopback, 防御性默认)
  - 多机多 agent: --host 0.0.0.0 (Tailscale mesh 转发)
  白名单策略 (loopback + 100.64.0.0/10 CGNAT) 不变, 变的只是 bind address.

管理:
  unload + load === 重启 (KeepAlive plist 触发):
    launchctl unload ~/Library/LaunchAgents/ai.mnelo.mcp.plist
    launchctl load ~/Library/LaunchAgents/ai.mnelo.mcp.plist
  真停 (不是重启):
    launchctl unload ~/Library/LaunchAgents/ai.mnelo.mcp.plist
  日志:
    tail -f ~/Library/Logs/mnelo.mcp.log
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.mnelo.mcp</string>
    <key>ProgramArguments</key>
    <array>
        <string>__VENV_PY__</string>
        <string>__LIVE_ROOT__/mcp_server.py</string>
        <string>--transport</string>
        <string>streamable-http</string>
        <string>--host</string>
        <string>__BIND_HOST__</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>MNELO_HOME</key>
        <string>__LIVE_ROOT__</string>
        <!-- [7/19] Port 显式走 env (config chain: env > toml > default).
             Plist 不传 --port 让 argparse 走 config.server_port. -->
        <key>MNELO_MEMORY_SERVER_PORT</key>
        <string>8086</string>
        <!-- [8/6] 切 zvec (zvec_available() debug 阶段, 失败会回落到 usearch).
             shell 手动跑 import zvec OK, MCP launchd 子进程 zvec_available()
             暂返 False, 主人后续 deploy 时再切 zvec 验证. -->
        <!-- [7/19 P1-7 fix] 去掉显式 PATH, 让 launchd 自动从 VIRTUAL_ENV prepend venv bin.
             之前的 PATH 包含 /Users/apple/hermes-agent/venv/bin (world-readable),
             任何本地 user 可以丢恶意 python3 shim → RCE on next kickstart. -->
        <key>VIRTUAL_ENV</key>
        <string>__VENV_DIR__</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <!-- [7/19 P2-10] ResourceLimits: 防止 recall 死循环拖垮 stack -->
    <key>SoftResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>2048</integer>
        <key>NumberOfProcesses</key>
        <integer>512</integer>
    </dict>
    <key>HardResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>4096</integer>
        <key>NumberOfProcesses</key>
        <integer>1024</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>__LIVE_ROOT__/logs/mnelo.mcp.log</string>
    <key>StandardErrorPath</key>
    <string>__LIVE_ROOT__/logs/mnelo.mcp.error.log</string>
    <key>WorkingDirectory</key>
    <string>__LIVE_ROOT__</string>
</dict>
</plist>
