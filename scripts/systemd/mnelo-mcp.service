# mnelo MCP memory server — systemd unit 模板
#
# 本文件由 scripts/install.sh 渲染 (sed 替换占位符) 后安装, 勿手改安装产物.
# 占位符: LIVE_ROOT / VENV_PY / MNELO_HOME / USER_LINE / WANTED_BY (带双下划线前缀).
#
# 安装位置 (由 install.sh 按权限决定):
#   root      → /etc/systemd/system/mnelo-mcp.service   (系统级 unit)
#                 User 行 = 运行用户, WantedBy=multi-user.target
#   非 root   → ~/.config/systemd/user/mnelo-mcp.service (用户级 unit)
#                 User 行 = 注释 (user unit 不允许 User=), WantedBy=default.target
#
# 管理:
#   系统级:  sudo systemctl {enable --now|restart|status} mnelo-mcp
#   用户级:  systemctl --user {enable --now|restart|status} mnelo-mcp
#   日志:    journalctl -u mnelo-mcp -f   (systemd journal + 下方 StandardOutput 双写)

[Unit]
Description=mnelo MCP memory server (SSE)
After=network.target

[Service]
Type=simple
__USER_LINE__
WorkingDirectory=__LIVE_ROOT__
# ⚠️ MNELO_MEMORY_SEARCH_BACKEND 必须显式 usearch — 无 AVX2 机 auto 链
# 主进程 import zvec 直接 SIGILL 崩进程 (见 docs/RUNBOOK.md §2.2). systemd 环境干净, 别赌 auto.
Environment=MNELO_MEMORY_DIR=__LIVE_ROOT__
Environment=MNELO_MEMORY_SEARCH_BACKEND=usearch
# 不传 --port: argparse default 走 config.server_port; 或用 MNELO_MEMORY_SERVER_PORT
Environment=MNELO_MEMORY_SERVER_PORT=8086
ExecStart=__VENV_PY__ __LIVE_ROOT__/mcp_server.py --transport streamable-http --host 127.0.0.1
# usearch 原生堆在无 AVX2 CPU 上有偶发启动崩溃 — Restart=always 崩溃后自动拉起
Restart=always
RestartSec=3
# 资源限制 (对齐 launchd plist): 防 recall 死循环拖垮 stack
LimitNOFILE=2048
LimitNPROC=512
StandardOutput=append:__LIVE_ROOT__/logs/mnelo.mcp.log
StandardError=append:__LIVE_ROOT__/logs/mnelo.mcp.error.log

[Install]
WantedBy=__WANTED_BY__
